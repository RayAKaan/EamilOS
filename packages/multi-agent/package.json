{
  "name": "@eamilos/multi-agent",
  "version": "1.3.0",
  "description": "EamilOS Dual-CLI Agent Orchestrator — OpenCode + Gemini CLI with Graphify knowledge graph",
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./agents": {
      "import": "./dist/agents/index.js",
      "types": "./dist/agents/index.d.ts"
    },
    "./graph": {
      "import": "./dist/graph/index.js",
      "types": "./dist/graph/index.d.ts"
    },
    "./orchestrator": {
      "import": "./dist/orchestrator/index.js",
      "types": "./dist/orchestrator/index.d.ts"
    }
  },
  "files": [
    "dist/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@eamilos/core": "^1.3.0",
    "chalk": "^5.4.0",
    "commander": "^13.1.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "multi-agent",
    "opencode",
    "gemini-cli",
    "eamilos",
    "orchestration",
    "knowledge-graph",
    "ai-agents",
    "cli-automation"
  ],
  "author": "Rayyan Ahmed Khan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RayAKaan/EamilOS.git"
  }
}
