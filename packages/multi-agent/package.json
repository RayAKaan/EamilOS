  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "multi-agent",
    "opencode",
    "gemini-cli",
