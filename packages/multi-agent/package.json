{
  "name": "@eamilos/multi-agent",
  "version": "1.2.8",
  "description": "EamilOS Dual-CLI Agent Orchestrator — OpenCode + Gemini CLI with Graphify knowledge graph",
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js",
    "./agents": "./dist/agents/index.js",
    "./graph": "./dist/graph/index.js",
    "./orchestrator": "./dist/orchestrator/index.js"
  },
  "files": [
