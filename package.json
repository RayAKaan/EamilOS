{
  "name": "eamilos",
  "version": "1.4.0",
  "description": "AI execution kernel — Multi-agent orchestration with OpenCode + Gemini CLI, knowledge graph, React Ink TUI, and intelligent model routing",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build -w @eamilos/cli",
    "test": "npm run test -w @eamilos/cli",
    "clean": "npm run clean -w @eamilos/cli",
    "reset": "rm -rf node_modules packages/*/node_modules packages/*/dist",
    "cli": "npx eamilos"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "agent",
    "ai",
    "multi-agent",
    "orchestration",
    "coordination"
  ],
